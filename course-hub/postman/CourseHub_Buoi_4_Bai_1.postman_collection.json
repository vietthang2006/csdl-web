              "pm.test(\"Response la mang JSON\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "});",
              "pm.test(\"So ban ghi mac dinh khong qua 20\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data.length).to.be.at.most(20);",
              "});"
