    {
      "name": "02 - Loc theo student_id (Co du lieu)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code la 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Co it nhat 1 ban ghi cua sinh vien 22000004\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data.length).to.be.greaterThan(0);",
              "    pm.expect(data.every(e => e.student_id === \"22000004\")).to.be.true;",
              "});",
              "pm.test(\"Cac truong bat buoc deu ton tai\", () => {",
              "    const item = pm.response.json()[0];",
              "    pm.expect(item).to.have.property(\"id\");",
              "    pm.expect(item).to.have.property(\"student_id\");",
              "    pm.expect(item).to.have.property(\"class_section_id\");",
              "    pm.expect(item).to.have.property(\"event_type\");",
              "    pm.expect(item).to.have.property(\"occurred_at\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
